// SPDX-License-Identifier: Apache-2.0

soong_config_string_variable {
    name: "display_core_abi_profile",
    values: ["sdm_abi_v2"],
}

soong_config_module_type {
    name: "lenovo_display_abi_genrule",
    module_type: "genrule",
    config_namespace: "lenovo_display",
    variables: ["display_core_abi_profile"],
    properties: ["cmd"],
}

// The generated header is the single ABI selection for every SDM consumer.
lenovo_display_abi_genrule {
    name: "display_core_abi_config",
    out: ["display_core_abi_config.h"],
    soong_config_variables: {
        display_core_abi_profile: {
            sdm_abi_v2: {
                cmd: "printf '// SPDX-License-Identifier: Apache-2.0\n#pragma once\n#define DISPLAY_CORE_ABI_V2 1\n' > $(out)",
            },
            conditions_default: {
                cmd: "printf '// SPDX-License-Identifier: Apache-2.0\n#pragma once\n#define DISPLAY_CORE_ABI_V2 0\n' > $(out)",
            },
        },
    },
}

cc_library_headers {
    name: "display_debug_headers",
    vendor: true,
    export_include_dirs: [
        "libdebug",
    ],
}

cc_library_headers {
  name: "display_core_headers",
  generated_headers: ["display_core_abi_config"],
  export_generated_headers: ["display_core_abi_config"],
  vendor: true,
  export_include_dirs: [
    "include",
    "libdrmutils",
    "sdm/include",
  ],
  header_libs: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
  export_header_lib_headers: [
      "libhardware_headers",
      "display_intf_headers",
      "display_debug_headers",
      "common_interface_headers",
      "snapalloc_interface_headers",
  ],
}
